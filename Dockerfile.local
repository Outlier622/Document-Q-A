FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libgl1 libglib2.0-0 poppler-utils tesseract-ocr tesseract-ocr-ben \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
# CPU wheel avoids downloading CUDA libraries for local Kubernetes.
RUN pip install torch==2.7.1 --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt
COPY app ./app
COPY frontend.py .
RUN mkdir -p app/data
EXPOSE 8000 8501
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
