# ECS/Fargate image for both the FastAPI service and the SQS worker.
# Fargate does not provide GPU resources, so use a CPU-only runtime.
FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libzbar0 \
        poppler-utils \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.ecs.txt /app/requirements.txt

# Install CPU PyTorch first. The matching torch==2.7.1 requirement is then
# already satisfied when the rest of requirements.txt is installed.
RUN python -m pip install --upgrade pip \
    && python -m pip install \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.7.1" \
    && python -m pip install -r /app/requirements.txt

COPY . /app

EXPOSE 8000

# Default command for the API task. The ECS worker task definition overrides
# this with: python -m app.workers.document_worker
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
